generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  name               String?
  creditsBalance     Int                 @default(12000)
  addonCredits       Int                 @default(0)
  lastAudioKey       String?
  lastAudioUrl       String?
  lastAudioUpdatedAt DateTime?
  lastAudioMp3Key    String?
  lastAudioMp3Url    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  plan               PlanTier            @default(FREE)
  planMonthlyCredits Int                 @default(10000)
  planStartedAt      DateTime            @default(now())

  // ── Subscription lifecycle ──────────────────────────────────────────────────
  // subscriptionStatus values:
  //   NONE     — FREE plan, no subscription
  //   ACTIVE   — paid plan, will auto-renew at currentPeriodEnd
  //   CANCELED — paid plan, will downgrade to FREE at currentPeriodEnd
  subscriptionStatus String              @default("NONE")
  currentPeriodEnd   DateTime?
  autoRenew          Boolean             @default(false)
  canceledAt         DateTime?

  // ── Dodo Payments external IDs ──────────────────────────────────────────────
  // dodoCustomerId — reused across checkouts so saved cards / billing details
  //   persist between sessions. Set on first successful checkout.
  // dodoSubscriptionId — present only while the user has an active or
  //   cancelled (but not-yet-expired) subscription. Used by the webhook to map
  //   events back to the user and by cancel/resume to call the Dodo API.
  dodoCustomerId     String?
  dodoSubscriptionId String?             @unique

  apiKeys            ApiKey[]
  transactions       CreditTransaction[]
  usageLogs          UsageLog[]
  presets            Json?               @default("[]")
}

model ApiKey {
  id         String     @id @default(uuid())
  userId     String
  keyHash    String     @unique
  prefix     String
  name       String
  createdAt  DateTime   @default(now())
  lastUsedAt DateTime?
  isActive   Boolean    @default(true)
  user       User       @relation(fields: [userId], references: [id])
  usageLogs  UsageLog[]
}

model CreditTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Int
  type        String
  description String?
  referenceId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  // Idempotency: one transaction per (user, type, referenceId). Prevents
  // duplicate top-ups when /verify or /dummy-topup is called twice with the
  // same payment id, and one MONTHLY_RESET per user per month.
  // Postgres allows multiple NULL referenceIds, so legacy rows without one
  // (e.g. raw USAGE_DEDUCT logs) are unaffected.
  @@unique([userId, type, referenceId], name: "uniq_user_tx_ref")
}

model UsageLog {
  id               String   @id @default(uuid())
  userId           String
  apiKeyId         String?
  endpointType     String
  charsCount       Int?
  emotionTagsCount Int?
  toneUsed         String?
  creditsDeducted  Int      @default(0)
  createdAt        DateTime @default(now())
  apiKey           ApiKey?  @relation(fields: [apiKeyId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
}

enum PlanTier {
  FREE
  STARTER
  CREATOR
  PRO
}
