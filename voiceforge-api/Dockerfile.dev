# ─────────────────────────────────────────────────────────────────────────────
# VoiceForge API — LOCAL DEV Dockerfile (CPU only, fast build ~200MB)
# Use this for local testing on Windows/Docker Desktop
# For GPU production (RunPod): use the main Dockerfile
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.10-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# ── System dependencies ───────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ffmpeg \
    libsndfile1 \
    libportaudio2 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ── Clone orpheus-tts-local ───────────────────────────────────────────────────
RUN git clone --depth=1 https://github.com/isaiahbjork/orpheus-tts-local /orpheus-tts-local

# ── App directory ─────────────────────────────────────────────────────────────
WORKDIR /app

# ── Python dependencies (CPU PyTorch — much smaller) ─────────────────────────
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cpu

# ── Core app deps ─────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir \
    fastapi==0.115.0 \
    uvicorn[standard]==0.30.6 \
    python-multipart==0.0.12 \
    python-dotenv==1.0.1 \
    numpy \
    soundfile \
    snac \
    requests \
    scipy \
    sounddevice

# ── STT (CPU mode) ────────────────────────────────────────────────────────────
RUN pip install --no-cache-dir faster-whisper

# ── orpheus-tts-local deps ────────────────────────────────────────────────────
RUN pip install --no-cache-dir -r /orpheus-tts-local/requirements.txt 2>/dev/null || true

# ── Copy application ──────────────────────────────────────────────────────────
COPY main.py .

# ── Environment ───────────────────────────────────────────────────────────────
ENV ORPHEUS_TTS_LOCAL_PATH=/orpheus-tts-local
# Make gguf_orpheus.py importable directly
ENV PYTHONPATH=/orpheus-tts-local
# LM Studio runs on your PC — Docker Desktop resolves host.docker.internal
ENV LM_STUDIO_HOST=host.docker.internal
ENV LM_STUDIO_PORT=1234
ENV TRANSFORMERS_CACHE=/cache/huggingface
ENV HF_HOME=/cache/huggingface

# ── Expose & run ─────────────────────────────────────────────────────────────
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
