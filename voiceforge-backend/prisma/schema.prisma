generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User holds account state + cached credit totals. Per-plan / per-top-up
// detail lives in Subscription and AddonGrant — usage drains those buckets
// in FIFO order (free monthly → oldest sub → oldest addon).
model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  name         String?

  // Denormalized total = freeCreditsRemaining + Σ Subscription.creditsRemaining
  //                    + Σ AddonGrant.creditsRemaining
  // Kept in sync inside every grant/drain transaction so the hot-path
  // gte-check on reserve doesn't have to SUM three tables.
  creditsBalance Int @default(12000)
  // Denormalized sum of AddonGrant.creditsRemaining — surfaced separately
  // because top-ups don't expire and the UI shows them apart from plan credits.
  addonCredits   Int @default(0)

  // Free-tier monthly bucket — every user gets one, no Subscription row needed.
  // Resets on the first authenticated request each calendar month.
  freeCreditsRemaining Int     @default(12000)
  freeMonthKey         String?

  lastAudioKey       String?
  lastAudioUrl       String?
  lastAudioUpdatedAt DateTime?
  lastAudioMp3Key    String?
  lastAudioMp3Url    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Dodo customer id is shared across this user's subscriptions and top-ups
  // so saved cards / billing addresses persist.
  dodoCustomerId String?

  apiKeys       ApiKey[]
  transactions  CreditTransaction[]
  usageLogs     UsageLog[]
  subscriptions Subscription[]
  addonGrants   AddonGrant[]
  presets       Json?               @default("[]")

  @@index([dodoCustomerId])
}

// One row per paid subscription. A user can hold many (any plan, any quantity).
// Each subscription has its own credit bucket that resets on renewal, its own
// cancel/autopay state, and its own Dodo subscription id.
model Subscription {
  id     String @id @default(uuid())
  userId String

  // STARTER | CREATOR | PRO — free-form text so adding a tier doesn't need a
  // schema migration. Validated against PLAN_CONFIG in code.
  planKey        String
  monthlyCredits Int

  // This subscription's remaining credits for the current billing period.
  // Renewals set this back to monthlyCredits. Drains in FIFO order with
  // sibling subscriptions (oldest createdAt first).
  creditsRemaining Int

  // ACTIVE       — renews at currentPeriodEnd if autoRenew=true
  // CANCELED     — scheduled to expire at currentPeriodEnd (still has access)
  // ON_HOLD      — Dodo dunning in progress; UI prompts card update
  // FAILED       — initial charge or dunning exhausted
  // EXPIRED      — period ended, bucket zeroed, no further renewals
  status           String    @default("ACTIVE")
  autoRenew        Boolean   @default(true)
  currentPeriodEnd DateTime
  canceledAt       DateTime?

  dodoSubscriptionId String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, status])
}

// One row per top-up purchase. Permanent credits — never expire. Drains
// last, after every monthly bucket (free + plan subs). Oldest first within
// the addon pool so refunds and accounting line up with purchase order.
model AddonGrant {
  id     String @id @default(uuid())
  userId String

  creditsRemaining Int
  originalAmount   Int
  amountUSD        Int

  dodoPaymentId String?  @unique
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model ApiKey {
  id         String     @id @default(uuid())
  userId     String
  keyHash    String     @unique
  prefix     String
  name       String
  createdAt  DateTime   @default(now())
  lastUsedAt DateTime?
  isActive   Boolean    @default(true)
  user       User       @relation(fields: [userId], references: [id])
  usageLogs  UsageLog[]
}

model CreditTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Int
  type        String
  description String?
  referenceId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  // Idempotency: one transaction per (user, type, referenceId). Prevents
  // duplicate top-ups and ensures one MONTHLY_RESET per (subscription, month).
  // Postgres allows multiple NULL referenceIds, so legacy rows without one
  // (e.g. raw USAGE_DEDUCT logs) are unaffected.
  @@unique([userId, type, referenceId], name: "uniq_user_tx_ref")
}

model UsageLog {
  id               String   @id @default(uuid())
  userId           String
  apiKeyId         String?
  endpointType     String
  charsCount       Int?
  emotionTagsCount Int?
  toneUsed         String?
  creditsDeducted  Int      @default(0)
  createdAt        DateTime @default(now())
  apiKey           ApiKey?  @relation(fields: [apiKeyId], references: [id])
  user             User     @relation(fields: [userId], references: [id])
}
